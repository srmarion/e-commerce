@model MvcWebApplication.ViewModels.MenuListings.EditViewModel

@{
    ViewData["Title"] = "Save Order";
}

<h4>Save Order</h4>
<hr />
@{
    if (!string.IsNullOrEmpty(Model.Message))
    {
        <div>@Model.Message</div>
    }
}
<div class="row">
    <div>
        <form asp-action="Save">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MenuListing.Name" class="control-label"></label>
                <input asp-for="MenuListing.Name" class="form-control" />
            </div>
            
            <div class="form-group">
                <label asp-for="MenuListing.Category" class="control-label"></label>
                <select asp-for="MenuListing.Category" asp-items="Model.CategoryList" class="form-selct">
                    <option value=""></option>
                </select>
                <span asp-validation-for="MenuListing.Category" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MenuListing.Cost" class="control-label"></label>
                <input asp-for="MenuListing.Cost" class="form-control" />
            </div>
            <input type="hidden" asp-for="MenuListing.ItemId" />
            <div>
                
                <input type="submit" value="Save" />
            </div>
        </form>
    </div>
</div>
<div>
    <a asp-action="Index">Cancel</a>
</div>
 