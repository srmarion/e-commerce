@model MvcWebApplication.ViewModels.Orders.GetOrderDetailsViewModel

@{
	ViewData["Title"] = "Order Details";
}

<h4>Order Details</h4>

<div>
    <p> User Id: @Model.Order.UserId<br </p>
	<p>Order Id : @Model.Order.OrderId<br /></p>
    <p>Order Date: @Model.Order.OrderDate<br /></p>
	<p>Order Total : @Model.Order.OrderTotal.ToString("C2")<br /></p>
 </div>


 @if (Model.Message.Length > 0)
{
	<div class="text-danger">@Model.Message</div>
}

@if (Model.OrderDetailsList.Count > 0)
{
<table class="table">
	<thead>
		<tr>
			<th>Item Id</th>
			<th>Name</th>
			<th>Category</th>
			<th>Cost</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model.OrderDetailsList)
		{
			<tr>
				<td>
					@item.ItemId
				</td>
				<td>
					@item.Name
				</td>
				<td>
					@item.Category
				</td>
				<td>
					@item.Cost.ToString("C2")
				</td>
				
			</tr>
		}
	</tbody>
</table>
}
else
{
<table class="displayList">
	<tr>
		<td style="width:100%;">
			There are no items in your cart.
		</td>
	</tr>
</table>
}

